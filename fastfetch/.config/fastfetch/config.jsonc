{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 18,
        "width": 30,
        "padding": {
            "top": 2,
            "left": 3,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "constants": [
            "──────────────────────" // Used to easily align boxes if you ever want to change widths
        ]
    },
    "modules": [
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────\u001b[1;32mHardware\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢 ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "green"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "green"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "green",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "disk",
            "key": "│ ├󰋊 ",
            "keyColor": "green",
            "format": "{1} / {2} ({3})"
        },
        {
            "type": "battery",
            "key": "└ └󰁹 ",
            "keyColor": "green",
            "format": "{4}% [{5}]"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────\u001b[1;33mSoftware\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "yellow"
        },
        {
            "type": "shell",
            "key": "└ └󰞷 ",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────────\u001b[1;34mDesktop\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "de",
            "key": "󰧨 ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "│ ├󰉦 ",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ ├󰆍 ",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "└ └󰛖 ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────────\u001b[1;36mNetwork\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "localip",
            "key": "󰩟 ",
            "keyColor": "cyan"
        },
        {
            "type": "publicip",
            "key": "│ ├󰩠 ",
            "keyColor": "cyan"
        },
        {
            "type": "wifi",
            "key": "└ └󰤨 ",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────\u001b[1;35mStatus\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "command",
            "key": "󰔚 ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐 ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "└ └󰃰 ",
            "keyColor": "magenta",
            "format": "{1}-{3}-{11} {14}:{17}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",
        {
            "type": "colors",
            "paddingLeft": 16,
            "symbol": "circle"
        }
    ]
}
