{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "height": 18,
        "width": 30,
        "padding": {
            "top": 2,
            "left": 3,
            "right": 3
        }
    },
    "display": {
        "separator": "  ",
        "constants": [
            "──────────────────────" // Used to easily align boxes if you ever want to change widths
        ]
    },
    "modules": [
        "break",

        // ──────────────────── Hardware ────────────────────
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────\u001b[1;32mHardware\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "host",
            "key": "󰌢 ",
            "keyColor": "green"
        },
        {
            "type": "board",
            "key": "│ ├󰚗 ",
            "keyColor": "green"
        },
        {
            "type": "chassis",
            "key": "│ ├󰇺 ",
            "keyColor": "green"
        },
        {
            "type": "cpu",
            "key": "│ ├󰻠 ",
            "keyColor": "green",
            "format": "{name} ({cores-physical}C/{cores-logical}T) @ {freq-max}"
        },
        {
            "type": "cpuusage",
            "key": "│ │ ├󰓅 ",
            "keyColor": "green",
            "format": "{percentage}"
        },
        {
            "type": "gpu",
            "key": "│ ├󰍹 ",
            "keyColor": "green",
            "format": "{name} ({vram-used} / {vram-total})"
        },
        {
            "type": "memory",
            "key": "│ ├󰑭 ",
            "keyColor": "green",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "swap",
            "key": "│ │ ├󰓡 ",
            "keyColor": "green",
            "format": "{used} / {total} ({percentage})"
        },
        {
            "type": "disk",
            "key": "│ ├󰋊 ",
            "keyColor": "green",
            "format": "{size-used} / {size-total} ({size-percentage}) - {mountpoint}"
        },
        {
            "type": "battery",
            "key": "│ ├󰁹 ",
            "keyColor": "green",
            "format": "{capacity}% [{status}]"
        },
        {
            "type": "poweradapter",
            "key": "└ └󰚥 ",
            "keyColor": "green"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",

        // ──────────────────── Software ────────────────────
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────\u001b[1;33mSoftware\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "yellow"
        },
        {
            "type": "kernel",
            "key": "│ ├󰌽 ",
            "keyColor": "yellow"
        },
        {
            "type": "packages",
            "key": "│ ├󰏗 ",
            "keyColor": "yellow",
            "format": "{all}"
        },
        {
            "type": "shell",
            "key": "│ ├󰞷 ",
            "keyColor": "yellow"
        },
        {
            "type": "initsystem",
            "key": "│ ├󰚥 ",
            "keyColor": "yellow"
        },
        {
            "type": "editor",
            "key": "└ └󰷈 ",
            "keyColor": "yellow"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",

        // ──────────────────── Desktop ────────────────────
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────────\u001b[1;34mDesktop\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "de",
            "key": "󰧨 ",
            "keyColor": "blue"
        },
        {
            "type": "wm",
            "key": "│ ├󱂬 ",
            "keyColor": "blue"
        },
        {
            "type": "wmtheme",
            "key": "│ │ ├󰉼 ",
            "keyColor": "blue"
        },
        {
            "type": "theme",
            "key": "│ ├󰉦 ",
            "keyColor": "blue"
        },
        {
            "type": "icons",
            "key": "│ ├󰀻 ",
            "keyColor": "blue"
        },
        {
            "type": "cursor",
            "key": "│ ├󰇀 ",
            "keyColor": "blue"
        },
        {
            "type": "font",
            "key": "│ ├󰛖 ",
            "keyColor": "blue"
        },
        {
            "type": "terminal",
            "key": "│ ├󰆍 ",
            "keyColor": "blue"
        },
        {
            "type": "terminalfont",
            "key": "└ └󰛖 ",
            "keyColor": "blue"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",

        // ──────────────────── Display ────────────────────
        {
            "type": "custom",
            "format": "\u001b[90m┌──────────────────────\u001b[1;35mDisplay\u001b[0;90m───────────────────────┐"
        },
        {
            "type": "display",
            "key": "󰍹 ",
            "keyColor": "magenta",
            "format": "{name}: {width}x{height} @ {refresh-rate}Hz"
        },
        {
            "type": "brightness",
            "key": "│ ├󰃠 ",
            "keyColor": "magenta"
        },
        {
            "type": "monitor",
            "key": "└ └󰕮 ",
            "keyColor": "magenta"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",

        // ──────────────────── Network ────────────────────
        {
            "type": "custom",
            "format": "\u001b[90m┌───────────────────────\u001b[1;36mNetwork\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "localip",
            "key": "󰩟 ",
            "keyColor": "cyan",
            "format": "{ipv4} ({ifname})"
        },
        {
            "type": "publicip",
            "key": "│ ├󰩠 ",
            "keyColor": "cyan"
        },
        {
            "type": "wifi",
            "key": "│ ├󰤨 ",
            "keyColor": "cyan",
            "format": "{ssid} ({signal-quality})"
        },
        {
            "type": "dns",
            "key": "└ └󰇧 ",
            "keyColor": "cyan"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",

        // ──────────────────── Status ────────────────────
        {
            "type": "custom",
            "format": "\u001b[90m┌────────────────────────\u001b[1;35mStatus\u001b[0;90m──────────────────────┐"
        },
        {
            "type": "command",
            "key": "󰔚 ",
            "keyColor": "magenta",
            "text": "birth_install=$(stat -c %W / 2>/dev/null || echo 0); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
        },
        {
            "type": "uptime",
            "key": "│ ├󰅐 ",
            "keyColor": "magenta"
        },
        {
            "type": "loadavg",
            "key": "│ ├󰓅 ",
            "keyColor": "magenta"
        },
        {
            "type": "processes",
            "key": "│ ├󰒓 ",
            "keyColor": "magenta"
        },
        {
            "type": "users",
            "key": "│ ├󰀄 ",
            "keyColor": "magenta"
        },
        {
            "type": "datetime",
            "key": "└ └󰃰 ",
            "keyColor": "magenta",
            "format": "{1}-{3}-{11} {14}:{17}"
        },
        {
            "type": "custom",
            "format": "\u001b[90m└────────────────────────────────────────────────────┘"
        },
        "break",

        // Colors
        {
            "type": "colors",
            "paddingLeft": 16,
            "symbol": "circle"
        }
    ]
}
